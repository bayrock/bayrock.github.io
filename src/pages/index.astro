---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
const title = "shojo.me";
const description = "i'm a fullstack developer, designer and software architect."
---
<Layout title={title} description={description}>
    <section id="about">
        <h2 id="heading">about</h2>
        <p>
            {description}&nbsp;
            i strive to design, build and deploy <a id="projects" class="dotted" href="/projects/#heading">projects</a> and services stylishly and efficiently whilst remaining true to my humble hobbyist roots.
        </p>
        <div class="center">
            <Button url="#contact" label="View contact links">contact me</Button>
        </div>
    </section>
    <section id="skills">
        <h2>skills</h2>
        <div class="skills center">
            <img class="skills__img" width="32" height="32" title="HTML" src="/icons/dev/html5-original.svg"/>
            <img class="skills__img" width="32" height="32" title="CSS" src="/icons/dev/css3-original.svg"/>
            <img class="skills__img" width="32" height="32" title="TypeScript" src="/icons/dev/typescript-original.svg"/>
            <img class="skills__img" width="32" height="32" title="Elixir" src="/icons/dev/elixir-original.svg"/>
            <img class="skills__img" width="32" height="32" title="Figma" src="/icons/dev/figma-original.svg"/>
            <img class="skills__img invert-black" width="32" height="32" title="Vercel" src="/icons/dev/vercel-original.svg"/>
            <img class="skills__img invert-black" width="32" height="32" title="Astro" src="/icons/dev/astro-plain.svg"/>
            <img class="skills__img" width="32" height="32" title="Arch (Linux)" src="/icons/dev/archlinux-original.svg"/>
            <img class="skills__img" width="32" height="32" title="Git" src="/icons/dev/git-original.svg"/>
            <img class="skills__img" width="32" height="32" title="Cloudflare" src="/icons/dev/cloudflare-original.svg"/>
        </div>
    </section>
    <section id="interests">
        <h2>interests</h2>
        <p>
            i enjoy <a id="typing" class="dotted" href="/typing/#heading">typing</a>, <a id="cinema" class="dotted" href="/cinema/#heading">cinema</a>, <a id="cinema" class="dotted" href="/music/#heading">music</a>, <a id="games" class="dotted" href="/games/#heading">games</a> and learning new things!<br>
            i'm currently single and identify as <a id="transfeminine" class="dotted" href="/blurb/transfeminine/#heading">transfeminine</a>
            &nbsp;and <a id="pansexual" class="dotted" href="/blurb/pansexual/#heading">pansexual</a>.
        </p>
    </section>
</Layout>

<style>
    .skills { margin-top: 8px; }
    .skills__img { margin: 8px 1px; }

    @media only screen and (min-width: 600px) {
        .skills__img {
            height: 40px;
            width: 40px;
            margin: 8px 4px;
        }
    }
</style>

<script>
    const contactButton = () => {
        const contact = document.getElementById("contact");
        if (window.location.hash == "#contact")
            contact?.classList.add("flash");

        const button = document.getElementById("call-to-action");
        button?.addEventListener("click", () => {
            contact?.classList.remove("flash");
            setTimeout(() => {
                contact?.classList.add("flash");
            }, 50);
        });
    }

    document.addEventListener('astro:page-load', contactButton);
</script>
