---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import TypingStats from "../components/TypingStats.astro";
import { getTypingStats } from '../modules/getTypingStats';
import getTimeRelative from "../modules/getTimeRelative";

const data = await getTypingStats();

const description = "serene's typing stats";
const frontmatter = {
    title: 'typing',
    citation: {
        url: 'https://api.shojo.me/monkeytype',
        name: 'api.shojo.me'
    },
    backlink: {
        url: '/#typing',
        name: '/home'
    },
    timestamp: getTimeRelative(data.timestamp)
}
---

<ArticleLayout title={frontmatter.title} frontmatter={frontmatter} description={description}>
    <TypingStats data={data} />
</ArticleLayout>
