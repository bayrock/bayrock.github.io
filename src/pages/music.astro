---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import Track from '../components/Track.astro';
import { getRecentTracks } from '../modules/getRecentTracks';
import getTimeRelative from "../modules/getTimeRelative";

const { songs, timestamp } = await getRecentTracks(5);

const description = "serene's music taste";
const frontmatter = {
    title: 'now playing',
    citation: {
        url: 'https://api.shojo.me/lastfm',
        name: 'api.shojo.me'
    },
    backlink: {
        url: '/#music',
        name: '/home'
    },
    timestamp: getTimeRelative(timestamp)
}
---
<ArticleLayout title={frontmatter.title} frontmatter={frontmatter} description={description}>
  <ul class="track-list">
    {songs.map((group) => <Track group={group} />)}
  </ul>
</ArticleLayout>

<script>
  import { getRecentTracks } from '../modules/getRecentTracks';
  import { renderTrack } from '../modules/renderTrack';
  import getTimeRelative from '../modules/getTimeRelative';

  async function refresh() {
    try {
      const { songs, timestamp } = await getRecentTracks(5);
      const list = document.querySelector('.track-list');
      if (list) list.innerHTML = songs.map(renderTrack).join('');

      const updatedEl = document.querySelector('#timestamp-music');
      if (updatedEl) updatedEl.textContent = getTimeRelative(timestamp);
    } catch (err) {
      console.error('lastfm refresh failed, keeping build-time data', err);
    }
  }

  function paintTimes() {
    document.querySelectorAll<HTMLTimeElement>('time[data-ts]').forEach((el) => {
      const ts = Number(el.dataset.ts);
      el.textContent = getTimeRelative(ts);
      el.dateTime = new Date(ts).toISOString();
    });
  }

  paintTimes();
  refresh();
  document.addEventListener('astro:page-load', () => {
    paintTimes();
    refresh();
  });
</script>
