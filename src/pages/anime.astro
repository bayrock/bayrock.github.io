---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import Anime from '../components/Anime.astro';
import { getRecentAnime } from '../modules/getRecentAnime';
import getTimeRelative from "../modules/getTimeRelative";

const { anime, timestamp } = await getRecentAnime(5);

const description = "serene's otaku life";
const frontmatter = {
    title: 'now weebing',
    citation: {
        url: 'https://api.shojo.me/myanimelist',
        name: 'api.shojo.me'
    },
    backlink: {
        url: '/#anime',
        name: '/home'
    },
    timestamp: getTimeRelative(timestamp)
}
---
<ArticleLayout title={frontmatter.title} frontmatter={frontmatter} description={description}>
  <ul class="anime-list">
    {anime.map((anime) => <Anime anime={anime} />)}
  </ul>
</ArticleLayout>

<script>
  import { getRecentAnime } from '../modules/getRecentAnime';
  import { renderAnime } from '../modules/renderAnime';
  import getTimeRelative from '../modules/getTimeRelative';

  const refresh = async () => {
      const list = document.querySelector('.anime-list');
      list?.setAttribute('data-loading', 'true');

      try {
          const { anime, timestamp } = await getRecentAnime(5);
          if (list) list.innerHTML = anime.map(renderAnime).join('');

          const updatedEl = document.getElementById('timestamp-myanimelist');
          if (updatedEl) updatedEl.textContent = getTimeRelative(timestamp);
      } catch (err) {
          console.error('myanimelist refresh failed, keeping build-time data', err);
      } finally {
          list?.removeAttribute('data-loading');
      }
  };

  refresh();
  document.addEventListener('astro:page-load', refresh);
</script>
