---
import type { AnimeEntry } from '../modules/getRecentAnime';
interface Props { entry: AnimeEntry }
const { entry } = Astro.props;

const statusClass = entry.status === 'Watching' ? 'badge--watching' : 'badge--planned';
const showProgress = entry.episodesTotal > 1;
---
<li class="anime">
  <img
    class="anime__art"
    src={entry.image ?? '/images/poster-placeholder.svg'}
    alt={`${entry.title} cover`}
    loading="lazy" width="42" height="60"
  />
  <div class="anime__meta">
    <a class="link anime__title" href={entry.url} target="_blank" rel="noopener">
      {entry.title}
    </a>
    <small class="gray">{entry.type}</small>
  </div>
  <div class="anime__right">
    <span class={`badge badge--item ${statusClass}`}>{entry.status}</span>
    {showProgress && (
      <small class="gray anime__progress">{entry.episodesWatched}/{entry.episodesTotal} eps</small>
    )}
  </div>
</li>
