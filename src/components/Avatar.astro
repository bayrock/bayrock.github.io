---
import { avatar } from '../../custom.config.mjs';
const { compact = false } = Astro.props;
const pfp = `https://avatars.githubusercontent.com/u/${avatar.githubID}?s=${avatar.size}`;
const mobileSize = compact ? 70 : 120;
const desktopSize = compact ? 80 : 140;
---
<picture>
    <img
        src={pfp}
        alt="profile picture"
        id="pfp"
        class="circle blur"
        width={mobileSize} height={mobileSize}
        transition:name="avatar"
    />
</picture>

<style define:vars={{ mobileSize: `${mobileSize}px`, desktopSize: `${desktopSize}px` }}>
    #pfp { width: var(--mobileSize); height: var(--mobileSize); }

    @media only screen and (min-width: 600px) {
        #pfp { width: var(--desktopSize); height: var(--desktopSize); }
    }
</style>

<script>
    const updatePFP = () => {
        const pfp = document.getElementById("pfp");
        const resize = pfp?.getAttribute("src")?.split("?")[0];
        if (!pfp || !resize) return;

        const isFirefox = navigator.userAgent.includes("Firefox");
        if (!isFirefox) pfp.classList.add("unblur");
        pfp.classList.remove("blur");
        pfp.setAttribute("src", resize);
    }

    document.addEventListener('astro:page-load', updatePFP);
</script>
